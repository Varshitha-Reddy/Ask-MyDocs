# OpenAI — get key from https://platform.openai.com
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone — get key from https://app.pinecone.io
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=rag-hybrid

# Elasticsearch (Docker default)
ES_HOST=http://localhost:9200
ES_INDEX=documents

# Redis (Docker default)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# Cohere re-ranking (optional — get key from https://dashboard.cohere.com)
# Leave empty to skip re-ranking and use RRF order directly
COHERE_API_KEY=

# Frontend tenant (optional — used by VITE_TENANT_ID in the React app)
# Leave empty for single-tenant usage; set to your org name for multi-tenant
VITE_TENANT_ID=default

# App
APP_PORT=8000
LOG_LEVEL=INFO
